{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "crons": [
    {
      "path": "/api/articles?task=publish",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/articles?task=draft&run=1",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/articles?task=draft&run=2",
      "schedule": "0 5 * * *"
    }
  ],
  "functions": {
    "api/articles.js": {
      "maxDuration": 300
    }
  },
