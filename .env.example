# Copy to .env.local and fill in. .env.local is gitignored — it never gets committed.
#
# SERVER-ONLY secrets (used by publish/build scripts + serverless functions).
# NEVER prefix these with VITE_ — VITE_ vars are bundled into the browser and would leak publicly.
SUPABASE_URL=https://fnlgclkcbkmoailfdukt.supabase.co
SUPABASE_SERVICE_ROLE_KEY=          # full-access key — server only, keep secret
SUPABASE_ANON_KEY=                  # publishable key — safe to expose

# Vercel Deploy Hook that triggers a rebuild of the platform site on publish.
DEPLOY_HOOK=

# Optional: password that gates publish/write requests (like the old EDIT_KEY).
EDIT_KEY=

# CLIENT-exposed (safe): the anon key + storage config can also be set in the cabinet
# (Настройки → Интеграции → Хранилище картинок). Only VITE_-prefixed vars reach the browser.
VITE_SUPABASE_URL=https://fnlgclkcbkmoailfdukt.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_MEDIA_BUCKET=article-images

# Publish, out-of-the-box (set these on the CABINET Vercel project → publishing works with no client
# input). VITE_PUBLISH_KEY is DELIBERATELY client-exposed (it ships in the cabinet bundle) — its value
# must equal the site's server EDIT_KEY. INTERIM stopgap: a login-based publish (real auth) replaces it
# in the backend phase; until then, use a long random key and restrict who can reach the cabinet.
VITE_PUBLISH_ENDPOINT=https://allclean.md/api/publish
VITE_PUBLISH_KEY=
